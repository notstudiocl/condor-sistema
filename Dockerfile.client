# App de terreno (client/) como sitio estático en EasyPanel. El backend sigue en ./Dockerfile.
FROM node:20-alpine AS build
WORKDIR /app
COPY client/package*.json ./
RUN npm ci
COPY client/ ./
# Vite hornea VITE_API_URL en el bundle al construir — cambiarlo exige rebuild.
ARG VITE_API_URL=https://condor-condor-app.f8ihph.easypanel.host/api
ENV VITE_API_URL=$VITE_API_URL
RUN npm run build

FROM nginx:1.27-alpine
COPY deploy/nginx-client.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html/condor-sistema
EXPOSE 80
