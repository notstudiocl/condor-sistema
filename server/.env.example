# Backend Condor 360 (Postgres + R2 + Gotenberg). Copiar a .env.staging / env vars de EasyPanel.
NODE_ENV=production
PORT=3000

# Postgres — obligatoria (el server no arranca sin ella)
DATABASE_URL=postgres://usuario:password@host:5432/condor-db

# Auth — JWT_SECRET obligatoria, compartida por el JWT de técnicos y el de admin
JWT_SECRET=
JWT_TECNICO_EXPIRES_IN=30d
JWT_ADMIN_EXPIRES_IN=12h
# warn = acepta requests sin token (PWAs viejas cacheadas); enforce = 401
AUTH_ENFORCE=warn
CORS_ORIGIN=*

# Cloudflare R2 (fotos, firmas, PDFs)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_ENDPOINT=
R2_PUBLIC_URL=

# Gotenberg (PDF)
GOTENBERG_URL=

# Master key de pgcrypto para los secretos de notification_channels
APP_ENCRYPTION_KEY=

# Base de los enlaces de invitación al panel
ADMIN_PANEL_URL=https://condor.notstudio.cl/admin/

# Notificaciones híbridas vía n8n (opcional; app_settings.webhook_notificaciones_url tiene prioridad)
WEBHOOK_NOTIFICACIONES_URL=
# Modo desarrollo: TODOS los correos van a esta casilla. Dejar vacío en producción.
EMAIL_DEV_REDIRECT=

# Kill switch de suscripción — solo se setea en EasyPanel, nunca desde las apps
SUBSCRIPTION_ACTIVE=true
SUBSCRIPTION_MESSAGE=
