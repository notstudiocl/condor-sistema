# Solo para el build de GitHub Pages (.github/workflows/deploy.yml, `vite build` sin Docker) que
# sirve la app en notstudiocl.github.io/condor-sistema/ — un origen DISTINTO al de
# condor.notstudio.cl. Desde el corte (2026-09-22) esa URL vieja sigue sirviendo la app NUEVA
# contra el backend nuevo, así los técnicos no reinstalan la PWA. El build de EasyPanel
# (Dockerfile.client) recibe estas variables como ARG y no usa este archivo.
VITE_API_URL=https://condor.notstudio.cl/api
VITE_ADMIN_APP_URL=https://condor.notstudio.cl/admin/
