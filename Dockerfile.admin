# Admin panel (admin/) como sitio estático en EasyPanel. El backend sigue en ./Dockerfile.
FROM node:20-alpine AS build
WORKDIR /app
COPY admin/package*.json ./
RUN npm ci
COPY admin/ ./
# Vite hornea VITE_API_URL en el bundle al construir — cambiarlo exige rebuild.
ARG VITE_API_URL=https://condor.notstudio.cl/api
ENV VITE_API_URL=$VITE_API_URL
# Base path bajo condor.notstudio.cl (GitHub Pages usa el default de vite.config.js)
ARG VITE_BASE=/admin/
ENV VITE_BASE=$VITE_BASE
RUN npm run build

FROM nginx:1.27-alpine
COPY deploy/nginx-admin.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html/admin
EXPOSE 80
